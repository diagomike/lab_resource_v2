# Copy to .env.development.local (git-ignored) — `next dev` then sends mail to Mailpit and uses the fake payment verifier.
# Development only (`next dev` reads this; `next build`/`next start`, the tests and the
# e2e harness do not). Every email the dev server sends goes to Mailpit on this machine
# instead of the real SMTP server in .env — the dev database holds real ARA addresses, so
# nobody can be mailed by accident.
#   npm run mail:catch      start Mailpit — the inbox is http://127.0.0.1:8026
# (or the "mail" launch configuration). Delete this file and restart the dev server to
# send through the real SMTP server again.
SMTP_HOST=127.0.0.1
SMTP_PORT=2526
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Payments in development: the fake verifier (no real bank is ever asked) and a test
# receiving account — a receipt reference FAKE-<birr> (e.g. FAKE-12500) is a payment of
# that many birr, FAKE-<birr>-WRONG paid someone else, FAKE-DOWN is an unreachable verifier.
VERIFIER_DRIVER=fake
PAYMENT_PROVIDERS=CBE,TELEBIRR
PAYMENT_CBE_RECEIVER_ACCOUNT=1000370930353
PAYMENT_TELEBIRR_RECEIVER_NAME=Adama Science and Technology University
UNIVERSITY_BANK_NAME=Commercial Bank of Ethiopia
UNIVERSITY_BANK_ACCOUNT_NAME=Adama Science and Technology University (TEST)
UNIVERSITY_BANK_ACCOUNT_NUMBER=1000370930353
