# Copy to .env and fill in real values. Never commit .env itself (it's gitignored).

# ── Database ────────────────────────────────────────────────────────────────
# Pooled connection — what the app's own queries use. On Neon/Supabase/Vercel
# Postgres this is the pooler endpoint; locally it's the same as DIRECT_URL below.
DATABASE_URL="postgresql://user:password@host:5432/lrms_v2"
# Direct (non-pooled) connection — what `prisma migrate` uses. Locally, set this to
# the exact same value as DATABASE_URL. On a pooled production target, this must be
# the provider's direct/unpooled endpoint, not the pooler.
DIRECT_URL="postgresql://user:password@host:5432/lrms_v2"

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30

# ── App origin ──────────────────────────────────────────────────────────────
# Used to build absolute links in emails (invitations, password resets) — must be
# the real deployment URL in production, or every emailed link points at localhost.
APP_ORIGIN="http://localhost:3000"

# ── Mail (SMTP) ─────────────────────────────────────────────────────────────
# Invitation, password-reset, and occupant-assignment emails. If this is unset or
# fails, mail.send() logs and swallows the error rather than blocking the request —
# the People page's copyable invite link (see PROGRESS.md's Phase 2.5 entry) exists
# specifically so a broken SMTP path never blocks onboarding.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="user@example.com"
SMTP_PASS="change-me"
MAIL_FROM="ASTU Lab Resources <no-reply@example.com>"

# ── Image storage ───────────────────────────────────────────────────────────
# "local" (default) writes to disk under IMAGE_STORAGE_DIR — fine for dev, but
# Vercel's filesystem is read-only and ephemeral, so production MUST use
# "vercel-blob" instead. See lib/server/resources/storage/index.ts's selector.
IMAGE_STORAGE_DRIVER=local
# IMAGE_STORAGE_DIR=./.local-storage/images   # "local" driver only; defaults shown

# Required when IMAGE_STORAGE_DRIVER=vercel-blob. Vercel sets this automatically
# once a Blob store is attached to the project — you shouldn't need to set it by
# hand except for local testing against a real Blob store.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Production bootstrap (prisma/bootstrap.ts) ─────────────────────────────
# Only needed once, when running `npm run bootstrap` against a fresh production
# database — see that script's own header and README.md's "Deploying" section.
# Never used by the app itself; not needed for local dev (use `npm run prisma:seed`
# instead, which creates admin@astu.edu.et / astu1234 automatically).
# BOOTSTRAP_ADMIN_EMAIL="admin@example.edu"
# BOOTSTRAP_ADMIN_PASSWORD="change-me-immediately"
# BOOTSTRAP_ADMIN_NAME="System Administrator"
# BOOTSTRAP_UNIVERSITY_NAME="Your University Name"
# BOOTSTRAP_UNIVERSITY_CODE="UNI"

# ── External bookings (public portal) ──────────────────────────────────────
# Shown to a requester in their quote and on their tracking page. Leave unset until
# the university's real collection account is confirmed — the quote then says the
# details will follow.
# UNIVERSITY_BANK_NAME="Commercial Bank of Ethiopia"
# UNIVERSITY_BANK_ACCOUNT_NAME="Adama Science and Technology University"
# UNIVERSITY_BANK_ACCOUNT_NUMBER="1000..."

# Vercel Cron calls /api/cron/expire-holds with "Authorization: Bearer $CRON_SECRET".
# CRON_SECRET="a-long-random-string"
